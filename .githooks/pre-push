#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Refuse to push an unsigned commit. Off unless the repository opts in with
#   git config --local hooks.maintainer true
# so a contributor pushing to their own fork is never blocked.
#
# This is the check that matters most: a rebase, cherry-pick, or filter-branch
# drops signatures and runs no commit hook, so nothing else notices.
#
# git feeds pre-push lines of: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

[ "$(git config --bool --get hooks.maintainer 2>/dev/null || echo false)" = "true" ] || exit 0

root="$(git rev-parse --show-toplevel)"
checker="$root/scripts/check-signing.sh"
[ -x "$checker" ] || checker="$HOME/.claude/skills/git-workflow/check-signing.sh"

zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"
    else
        range="$remote_sha..$local_sha"
    fi
    "$checker" --range "$range" || status=1
done

exit "$status"

#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Refuse to push a commit that is not signed. Catches signatures dropped by a
# rebase, cherry-pick, or filter-branch, none of which run a commit hook.
#
# git feeds pre-push lines of: <local ref> <local sha> <remote ref> <remote sha>
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
checker="$root/scripts/check-signing.sh"
[ -x "$checker" ] || checker="$HOME/.claude/skills/git-workflow/check-signing.sh"

zero=0000000000000000000000000000000000000000
status=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue          # branch deletion
    if [ "$remote_sha" = "$zero" ]; then
        range="$local_sha"                          # new branch: whole history
    else
        range="$remote_sha..$local_sha"
    fi
    "$checker" --range "$range" || status=1
done

exit "$status"

#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
#
# Refuse to create a commit that is unsigned or authored under the wrong
# identity. Runs before the commit object exists, so both fail with an
# explanation rather than leaving a bad commit to discover later.
set -euo pipefail

root="$(git rev-parse --show-toplevel)"

run() {
    local local_copy="$root/scripts/$1"
    if [ -x "$local_copy" ]; then
        "$local_copy" "${@:2}"
    else
        "$HOME/.claude/skills/git-workflow/$1" "${@:2}"
    fi
}

run check-identity.sh
run check-signing.sh --config
